# ─────────────────────────────────────────────────────────────────
# Copiar a .env y rellenar antes de levantar los contenedores
# NUNCA subir .env al repositorio
# ─────────────────────────────────────────────────────────────────

# PostgreSQL
POSTGRES_DB=biomasa
POSTGRES_USER=biomasa_user
POSTGRES_PASSWORD=CAMBIA_ESTO_POR_CLAVE_SEGURA

# JWT — genera con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CAMBIA_ESTO_POR_SECRET_ALEATORIO_64_BYTES

# MinIO
MINIO_ROOT_USER=biomasa_minio
MINIO_ROOT_PASSWORD=CAMBIA_ESTO_POR_CLAVE_SEGURA

# SMTP — smtp.serviciodecorreo.es puerto 465 SSL/TLS
SMTP_HOST=smtp.serviciodecorreo.es
SMTP_PORT=465
SMTP_USER=biomasa@cserintranet.com
SMTP_PASS=RELLENAR_CON_CONTRASEÑA
SMTP_FROM="Albaranes Biomasa <biomasa@cserintranet.com>"

# Microsoft Entra ID (Azure AD) SSO — ver deploy/SSO_ENTRA_ID.md
# Redirect URI a registrar en Entra: https://biomasa.cserintranet.com/api/auth/microsoft/callback
# Si TENANT/CLIENT/SECRET se dejan vacías, el botón de Microsoft no aparece.
AZURE_AD_TENANT_ID=                 # GUID del tenant (no el dominio)
AZURE_AD_CLIENT_ID=                 # Application (client) ID
AZURE_AD_CLIENT_SECRET=             # valor del secreto (no su ID); anotar caducidad
AZURE_AD_ALLOWED_DOMAINS=comsa.com  # dominios de email admitidos, separados por coma
AZURE_AD_ENFORCE=false              # true = cuentas de esos dominios solo entran con Microsoft
AZURE_AD_ROLE_SYNC=false            # true = el nivel sale de los roles de app de Entra
AZURE_AD_SINGLE_LOGOUT=false        # true = salir de la app cierra también la sesión de Microsoft
